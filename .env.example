# Development uses Cloudflare's public Turnstile test keys automatically.
# Set real Turnstile keys in Vercel Production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Verify fgacic.com in Resend before sending from contact@fgacic.com.
RESEND_API_KEY=
FROM_EMAIL=contact@fgacic.com
NOTIFY_EMAIL=filip.gacic98@gmail.com

# Local Playwright only. Production ignores this flag.
DISABLE_EMAIL=false
